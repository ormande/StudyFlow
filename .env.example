# =============================================================================
# StudyFlow — mapa de variáveis de ambiente
# =============================================================================
# Copie:  copy .env.example .env
# Local:  C:\Users\User\Desktop\StudyFlow\.env  (raiz, ao lado do package.json)
#
# ⚠️  service_role NÃO vai no .env do frontend — só no Supabase (Edge Functions Secrets)
# =============================================================================

# --- FRONTEND (Vite) — obrigatórias para npm run dev / build ---
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...sua_chave_anon_ou_publishable...

# --- FRONTEND — opcional (só produção; src/main.tsx) ---
# Sentry → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# =============================================================================
# NÃO coloque no .env local do Vite (vazaria no bundle do navegador):
#   SUPABASE_SERVICE_ROLE_KEY / service_role
# =============================================================================

# =============================================================================
# SUPABASE → Edge Functions → Secrets (projeto StudyFlow 2)
# Configure no painel, não neste arquivo:
# =============================================================================
# SUPABASE_URL              = mesma URL do projeto (https://xxx.supabase.co)
# SUPABASE_ANON_KEY         = mesma anon key (funções que validam JWT do usuário)
# SB_SERVICE_ROLE_KEY       = service_role (Settings → API → service_role secret)
#
# EFI_CLIENT_ID             = Efí Bank (legado — aguardando migração Asaas)
# EFI_CLIENT_SECRET         = Efí Bank (legado)
# EFI_SANDBOX               = true (teste) ou false (produção)
# (Futuro: secrets ASAAS_* após integração)
#
# BREVO_API_KEY             = e-mails transacionais (opcional)
# TELEGRAM_BOT_TOKEN        = bot de suporte (opcional)
# ADMIN_CHAT_ID             = Telegram (opcional)
# FUNCTION_SECRET           = segredo do webhook telegram-bot (opcional)

# =============================================================================
# BACKUP MANUAL LOCAL (backup-scripts/backup.js — se usar)
# Arquivo separado ou .env só na pasta backup-scripts, NÃO commitar:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
# =============================================================================

# =============================================================================
# VERCEL (produção) — Environment Variables no painel Vercel
# Mesmas do frontend:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#   VITE_SENTRY_DSN
# =============================================================================
